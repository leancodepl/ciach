{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "dart pub get && dart pub global activate --source git https://github.com/schultek/jaspr --git-path packages/jaspr_cli --git-ref 9311973c7261b4a37ee2cb526466aa6934854851",
  "buildCommand": "bash tool/build.sh",
  "outputDirectory": "build/jaspr",
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    },
    {
      "source": "/(images/.*|fonts/.*|favicon\\..*|apple-touch-icon\\.png|icon-[0-9]+\\.png)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600, stale-while-revalidate=86400"
        }
      ]
    }
  ]
}
